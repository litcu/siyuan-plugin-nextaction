{
  "name": "siyuan-plugin-nextaction",
  "version": "0.8.0",
  "type": "module",
  "description": "GTD task management plugin for SiYuan",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "test": "node --import tsx --test --test-concurrency=4 tests/*.test.ts",
    "benchmark:sync": "node --import tsx scripts/benchmark-sync.js",
    "test:integration:kernel": "node --env-file-if-exists=.env.local scripts/test-kernel.js",
    "test:integration:mcp": "node --env-file-if-exists=.env.local scripts/test-mcp.js",
    "dev": "run-p dev:kernel dev:app",
    "dev:app": "vite build --watch --mode development",
    "dev:kernel": "webpack --config webpack.kernel.config.js --mode development",
    "build": "run-s build:kernel build:app",
    "build:app": "vite build --mode production",
    "build:kernel": "webpack --config webpack.kernel.config.js --mode production",
    "pack": "node scripts/package.js",
    "release:package": "run-s build pack",
    "release:current": "node scripts/release-version.js current",
    "release:patch": "node scripts/release-version.js patch",
    "release:minor": "node scripts/release-version.js minor",
    "release:major": "node scripts/release-version.js major",
    "release:version": "node scripts/release-version.js",
    "release:publish": "node scripts/release-publish.js",
    "check:types": "run-p check:types:shared check:types:frontend check:types:kernel check:types:tests",
    "check:types:shared": "tsc -p tsconfig.shared.json",
    "check:types:frontend": "tsc -p tsconfig.frontend.json",
    "check:types:kernel": "tsc -p tsconfig.kernel.json",
    "check:types:tests": "tsc -p tsconfig.tests.json",
    "check:svelte": "svelte-check --workspace . --config ./svelte.config.js --tsconfig ./tsconfig.frontend.json --fail-on-warnings",
    "lint": "eslint src tests scripts *.js",
    "format": "prettier --write \"src/**/*.{ts,svelte,scss}\" \"tests/**/*.ts\" \"scripts/**/*.{js,ts}\" \"*.{js,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,svelte,scss}\" \"tests/**/*.ts\" \"scripts/**/*.{js,ts}\" \"*.{js,ts}\"",
    "check:architecture": "node scripts/check-architecture.js",
    "check:theme": "node scripts/check-theme-adaptation.js",
    "check:whitespace": "git diff --check",
    "check": "run-s test check:types check:svelte lint format:check check:architecture check:theme build check:whitespace",
    "deploy": "node scripts/deploy.js",
    "release": "run-s build deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^3",
    "@types/node": "^26.2.0",
    "copy-webpack-plugin": "^14",
    "esbuild-loader": "^4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "mini-css-extract-plugin": "^2",
    "npm-run-all": "^4",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.5.2",
    "sass": "^1",
    "siyuan": "1.2.4",
    "svelte": "^4",
    "svelte-check": "4.7.6",
    "tslib": "^2",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "typescript-eslint": "^8.67.0",
    "vite": "^5",
    "vite-plugin-static-copy": "^1",
    "webpack": "^5",
    "webpack-cli": "^7"
  },
  "dependencies": {
    "chrono-node": "2.10.1"
  }
}
